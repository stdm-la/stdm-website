# Public site URL (used for sitemap, canonical URLs, Open Graph, Schema.org)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AWS SES Configuration (for production - set in Amplify Console)
# CONTACT_FORM_RECIPIENT_EMAIL=your-email@example.com
# CONTACT_FORM_FROM_EMAIL=noreply@yourdomain.com
# AWS_REGION=us-east-1

# WhatsApp Business number in international format without + (Costa Rica default)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# CRM: Contact forms are embedded HubSpot forms (portal configured in ContactForm.tsx).
# Lead source/interest are passed via URL hash query params to /#contact for attribution tracking.
# To connect additional CRM webhooks later, add server-side keys here (never expose secret tokens with NEXT_PUBLIC_).
